{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-sms-tasks",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "app" } },
    { "source": "/billing/(.*)", "destination": { "service": "app" } },
    { "source": "/login", "destination": { "service": "app" } },
    { "source": "/logout", "destination": { "service": "app" } },
    { "source": "/change-password", "destination": { "service": "app" } },
    { "source": "/portal", "destination": { "service": "app" } },
    { "source": "/auth/(.*)", "destination": { "service": "app" } },
    { "source": "/admin/(.*)", "destination": { "service": "app" } },
    { "source": "/teacher/(.*)", "destination": { "service": "app" } },
    { "source": "/student/(.*)", "destination": { "service": "app" } },
    { "source": "/parent/(.*)", "destination": { "service": "app" } },
    { "source": "/superadmin", "destination": { "service": "app" } },
    { "source": "/superadmin/(.*)", "destination": { "service": "app" } },
    { "source": "/onboarding/(.*)", "destination": { "service": "app" } },
    { "source": "/static/(.*)", "destination": { "service": "app" } },
    { "source": "/health", "destination": { "service": "app" } },
    { "source": "/sw.js", "destination": { "service": "app" } },
    { "source": "/manifest.json", "destination": { "service": "app" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
