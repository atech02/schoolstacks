# EduManage SaaS — Environment Configuration Template
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-secure-random-string

# Database (SQLite default in dev; use PostgreSQL URL in production)
# DATABASE_URL=postgresql://user:password@host:5432/edumanage

# Domain & Superadmin
BASE_DOMAIN=localhost
APP_PROTOCOL=http
SUPERADMIN_EMAIL=superadmin@edumanage.zm
ADMIN_PASSWORD=SuperAdmin123!

# Lipila Payment Integration (Zambia — Mobile Money & Cards)
# Leave LIPILA_API_KEY empty in development to use the built-in Sandbox Simulator
LIPILA_ENV=sandbox
LIPILA_SANDBOX_URL=https://api.lipila.dev/api/v1
LIPILA_LIVE_URL=https://api.lipila.io/api/v1
LIPILA_API_KEY=
LIPILA_WEBHOOK_SECRET=
LIPILA_CALLBACK_URL=
LIPILA_CURRENCY=ZMW

# Email (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@edumanage.zm
